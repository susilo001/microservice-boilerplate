# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8003
GIN_MODE=debug                        # debug | release

# ── Database ──────────────────────────────────────────────────────────────────
# Supported drivers: postgres | mysql | sqlite | sqlserver
DB_DRIVER=postgres

# DSN format per driver:
#   postgres   → postgres://user:pass@host:5432/db?sslmode=disable
#   mysql      → user:pass@tcp(host:3306)/db?charset=utf8mb4&parseTime=True&loc=Local
#   sqlite     → file path (e.g. app.db) or :memory:
#   sqlserver  → sqlserver://user:pass@host:1433?database=db
DB_DSN=postgres://postgres:postgres@localhost:5432/productdb?sslmode=disable

# Read replicas (optional — comma-separated DSNs).
# When set, GORM DBResolver routes SELECT queries to replicas (random policy)
# and all writes to the primary above. Pool settings apply to each replica too.
#DB_REPLICA_DSNS=postgres://user:pass@replica1:5432/productdb?sslmode=disable,postgres://user:pass@replica2:5432/productdb?sslmode=disable

# Connection pool (optional — defaults shown, applied to primary and each replica)
#DB_MAX_OPEN_CONNS=25                 # max simultaneous connections
#DB_MAX_IDLE_CONNS=10                 # connections kept idle in pool
#DB_CONN_MAX_LIFETIME=5m              # max age of a reused connection
#DB_CONN_MAX_IDLE_TIME=5m             # max idle time before closing a connection

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
#REDIS_PASSWORD=                      # leave unset if auth is disabled
#REDIS_DB=0                           # database index (0–15)

# Connection pool (optional — defaults shown)
#REDIS_POOL_SIZE=10                   # max socket connections
#REDIS_MIN_IDLE_CONNS=5              # minimum idle connections kept open
#REDIS_MAX_RETRIES=3                  # retries on transient network errors

# Timeouts (optional — defaults shown)
#REDIS_DIAL_TIMEOUT=5s
#REDIS_READ_TIMEOUT=3s
#REDIS_WRITE_TIMEOUT=3s

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092           # comma-separated: broker1:9092,broker2:9092

# Producer tuning (optional — defaults shown)
#KAFKA_BATCH_SIZE=100                  # max messages per batch
#KAFKA_BATCH_TIMEOUT=1s               # max wait before flushing a partial batch
#KAFKA_REQUIRED_ACKS=all              # all | leader | none
#KAFKA_ASYNC=false                    # true = fire-and-forget (no delivery guarantee)
#KAFKA_COMPRESSION=none               # none | gzip | snappy | lz4 | zstd

# analytics domain's ingest topic + consumer group (optional — defaults shown)
#KAFKA_TOPIC=raw-events
#KAFKA_CONSUMER_GROUP=analytics-processor

# ── Analytics (internal/analytics — raw pgxpool, separate from the GORM pool) ──
# Postgres-only DSN used by pkg/databases.NewRawPool for COPY-based bulk writes.
ANALYTICS_DB_DSN=postgres://postgres:postgres@localhost:5432/analyticsdb?sslmode=disable

# Pool + consumer batching (optional — defaults shown)
#ANALYTICS_DB_MAX_CONNS=10            # separate from the GORM pool — fewer, larger transactions
#BATCH_SIZE=500                       # consumer flush trigger: record count
#BATCH_TIMEOUT=200ms                  # consumer flush trigger: max wait

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=product-service

# The two exporter vars below are read directly by the OTel SDK (not by Viper).
# Traces  — OTLP/HTTP exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Metrics — OTLP/gRPC exporter (no http:// scheme)
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=localhost:4317
